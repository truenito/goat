#!/bin/bash

# Carry the active Omarchy theme into apps Omarchy doesn't theme itself:
#
#   Zen browser  <profile>/chrome/userChrome.css and userContent.css
#   GTK apps     ~/.config/gtk-4.0/gtk.css and ~/.config/gtk-3.0/gtk.css
#
#   harmony          generate from the active theme's colors.toml
#   harmony --clean  remove everything harmony generated
#
# Works with any theme. Files without our header are backed up, never replaced.

set -euo pipefail

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
MARK="Generated by goat harmony"
ZEN="$HOME/.config/zen"
GTK_FILES=("$HOME/.config/gtk-4.0/gtk.css" "$HOME/.config/gtk-3.0/gtk.css")

zen_profiles() {
  [[ -f $ZEN/profiles.ini ]] || return 0
  sed -n 's/^Path=//p' "$ZEN/profiles.ini" | while IFS= read -r path; do
    [[ -d $ZEN/$path ]] && echo "$ZEN/$path"
  done
}

generated_files() {
  printf '%s\n' "${GTK_FILES[@]}"
  zen_profiles | while IFS= read -r profile; do
    echo "$profile/chrome/userChrome.css"
    echo "$profile/chrome/userContent.css"
  done
}

ours() {
  [[ -f $1 ]] && grep -q "$MARK" "$1"
}

clean() {
  generated_files | while IFS= read -r file; do
    if ours "$file"; then rm -f "$file"; fi
  done
}

# Write stdin to $1, setting aside a file that isn't ours first.
emit() {
  mkdir -p "$(dirname "$1")"
  if [[ -f $1 ]] && ! ours "$1"; then
    mv "$1" "$1.bak.$(date +%s)"
  fi
  { echo "/* $MARK from the active Omarchy theme. Edits are overwritten. */"; cat; } >"$1"
}

if [[ ${1:-} == --clean ]]; then
  clean
  exit 0
fi

[[ -f $COLORS ]] || exit 0

c() {
  omarchy-theme-color --file "$COLORS" "$1" "${2:-}"
}

BG=$(c background)
DARK_BG=$(c dark_background "$BG")
DARKER_BG=$(c darker_background "$DARK_BG")
LIGHT_BG=$(c lighter_background "$BG")
FG=$(c foreground)
DIM_FG=$(c dark_foreground "$FG")
BRIGHT_FG=$(c bright_foreground "$FG")
ACCENT=$(c accent)
SELECTION=$(c selection "$LIGHT_BG")
RED=$(c red)
GREEN=$(c green)
YELLOW=$(c yellow)
MODE=$(c mode dark)

# Focus rings use the window-border colour: the first colour of the Hyprland
# border gradient, else the accent.
BORDER=$(c hyprland_active_border | grep -oiE '[0-9a-f]{6}' | head -1 || true)
BORDER=${BORDER:+#$BORDER}
BORDER=${BORDER:-$ACCENT}

# ---------------------------------------------------------------- Zen

zen_chrome() {
  emit "$1" <<EOF
:root {
  --zen-primary-color: $ACCENT !important;
  --zen-branding-bg: $BG !important;
  --zen-branding-dark: $BG !important;
  --zen-main-browser-background: $BG !important;
  --zen-main-browser-background-toolbar: $BG !important;
  --zen-themed-toolbar-bg-transparent: $BG !important;

  --zen-colors-primary: color-mix(in srgb, $ACCENT 18%, $LIGHT_BG) !important;
  --zen-colors-secondary: color-mix(in srgb, $ACCENT 28%, $LIGHT_BG) !important;
  --zen-colors-tertiary: $DARK_BG !important;
  --zen-colors-hover-bg: color-mix(in srgb, $FG 8%, transparent) !important;
  --zen-colors-primary-foreground: $FG !important;
  --zen-colors-border: color-mix(in srgb, $FG 12%, transparent) !important;
  --zen-colors-input-bg: $DARK_BG !important;
  --zen-dialog-background: $LIGHT_BG !important;
  --zen-urlbar-background: $LIGHT_BG !important;

  --toolbox-textcolor: $FG !important;
  --toolbarbutton-icon-fill: $FG !important;
  --toolbar-field-color: $FG !important;
  --toolbar-field-background-color: $LIGHT_BG !important;
  --toolbar-field-focus-color: $BRIGHT_FG !important;
  --toolbar-field-focus-background-color: $LIGHT_BG !important;
  --arrowpanel-background: $LIGHT_BG !important;
  --arrowpanel-color: $FG !important;
  --arrowpanel-border-color: color-mix(in srgb, $FG 10%, transparent) !important;
  --panel-separator-color: color-mix(in srgb, $FG 12%, transparent) !important;

  --tab-selected-bgcolor: color-mix(in srgb, $ACCENT 16%, $LIGHT_BG) !important;
  --tab-selected-textcolor: $BRIGHT_FG !important;
  --tab-hover-background-color: color-mix(in srgb, $FG 7%, transparent) !important;
  --focus-outline-color: $BORDER !important;
}

/* Address bar: a border-coloured ring when focused, like a focused window. */
#urlbar[focused] > #urlbar-background {
  outline: 1.5px solid $BORDER !important;
  outline-offset: -1px !important;
}

::selection {
  background-color: color-mix(in srgb, $ACCENT 35%, transparent) !important;
}
EOF
}

zen_content() {
  emit "$1" <<EOF
@-moz-document url-prefix("about:") {
  :root {
    --in-content-page-background: $BG !important;
    --in-content-page-color: $FG !important;
    --in-content-box-background: $LIGHT_BG !important;
    --in-content-box-border-color: color-mix(in srgb, $FG 12%, transparent) !important;
    --in-content-accent-color: $ACCENT !important;
    --in-content-primary-button-background: $ACCENT !important;
    --in-content-primary-button-text-color: $BG !important;
    --in-content-primary-button-background-hover: color-mix(in srgb, $ACCENT 85%, $BRIGHT_FG) !important;
    --in-content-primary-button-background-active: color-mix(in srgb, $ACCENT 80%, $BG) !important;
    --link-color: $ACCENT !important;
  }
}

@-moz-document url("about:newtab"), url("about:home"), url("about:privatebrowsing") {
  :root, body {
    background-color: $BG !important;
    color: $FG !important;
  }
}
EOF
}

apply_zen() {
  local pref='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
  zen_profiles | while IFS= read -r profile; do
    zen_chrome "$profile/chrome/userChrome.css"
    zen_content "$profile/chrome/userContent.css"
    grep -qF "$pref" "$profile/user.js" 2>/dev/null || echo "$pref" >>"$profile/user.js"
  done
}

# ---------------------------------------------------------------- GTK

# libadwaita colour names. GTK 4 gets each as @define-color and, for
# libadwaita 1.6+, as a CSS variable; GTK 3 reads the @define-color form.
gtk_palette() {
  cat <<EOF
accent_color $ACCENT
accent_bg_color $ACCENT
accent_fg_color $BG
window_bg_color $BG
window_fg_color $FG
view_bg_color $BG
view_fg_color $FG
headerbar_bg_color $DARK_BG
headerbar_fg_color $FG
headerbar_backdrop_color $DARK_BG
sidebar_bg_color $DARK_BG
sidebar_fg_color $FG
sidebar_backdrop_color $DARK_BG
secondary_sidebar_bg_color $DARKER_BG
secondary_sidebar_fg_color $FG
card_bg_color $LIGHT_BG
card_fg_color $FG
dialog_bg_color $LIGHT_BG
dialog_fg_color $FG
popover_bg_color $LIGHT_BG
popover_fg_color $FG
thumbnail_bg_color $LIGHT_BG
thumbnail_fg_color $FG
destructive_bg_color $RED
success_bg_color $GREEN
warning_bg_color $YELLOW
error_bg_color $RED
EOF
}

# The older GTK 3 names, on top of the libadwaita ones.
gtk3_extras() {
  cat <<EOF
theme_bg_color $BG
theme_fg_color $FG
theme_base_color $BG
theme_text_color $FG
theme_selected_bg_color $ACCENT
theme_selected_fg_color $BG
insensitive_fg_color $DIM_FG
borders $SELECTION
EOF
}

define_colors() {
  while read -r name value; do
    echo "@define-color $name $value;"
  done
}

css_variables() {
  echo ":root {"
  while read -r name value; do
    echo "  --${name//_/-}: $value;"
  done
  echo "}"
}

apply_gtk() {
  # Light themes keep stock Adwaita: these overrides assume a dark palette.
  if [[ $MODE == light ]]; then
    for file in "${GTK_FILES[@]}"; do
      if ours "$file"; then rm -f "$file"; fi
    done
    return 0
  fi

  { gtk_palette | define_colors; echo; gtk_palette | css_variables; } | emit "${GTK_FILES[0]}"
  { gtk3_extras; gtk_palette; } | define_colors | emit "${GTK_FILES[1]}"
}

apply_zen
apply_gtk
